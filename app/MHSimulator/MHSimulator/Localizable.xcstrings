        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출현 패턴은 커뮤니티의 분석 정보를 바탕으로 구성되어 실제 게임 내용과 다를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
