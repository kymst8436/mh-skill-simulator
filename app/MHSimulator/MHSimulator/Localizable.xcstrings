    "リワード広告を再生することで8時間の間全ての広告が非表示となります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich eine Prämienanzeige an, um alle Anzeigen 8 Stunden lang auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch a rewarded ad to hide all ads for 8 hours."
          }
        },
        "es": {
