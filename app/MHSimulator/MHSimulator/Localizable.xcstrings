    "[+追加] から所持している鑑定護石を登録してください": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf [+ Hinzufügen], um Ihre Talismane zu registrieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap [+ Add] to register the charms you own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca [+ Añadir] para registrar tus amuletos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez [+ Ajouter] pour enregistrer vos talismans"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[+ 추가]에서 소지한 감정 호석을 등록해 주세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em [+ Adicionar] para registrar seus amuletos"
          }
        }
      }
    },
    "[+追加] で欲しい護石を登録できます。検索結果の護石候補からもワンタップで追加できます": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit [+ Hinzufügen] registrieren Sie gewünschte Talismane. Auch aus den Vorschlägen der Suchergebnisse mit einem Tipp möglich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use [+ Add] to register charms you want. You can also add them with one tap from charm suggestions in search results"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con [+ Añadir] puedes registrar los amuletos que quieras. También puedes añadirlos con un toque desde las sugerencias de los resultados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez [+ Ajouter] pour enregistrer les talismans souhaités. Vous pouvez aussi les ajouter d'un geste depuis les suggestions des résultats"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[+ 추가]로 원하는 호석을 등록할 수 있습니다. 검색 결과의 호석 후보에서도 한 번의 탭으로 추가할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com [+ Adicionar] você registra os amuletos desejados. Também dá para adicioná-los com um toque nas sugestões dos resultados"
          }
        }
      }
    },
    "「%@」に一致するスキルはありません": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fertigkeiten entsprechen „%@“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No skills match \"%@\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna habilidad coincide con \"%@\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun talent ne correspond à « %@ »"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"과(와) 일치하는 스킬이 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma habilidade corresponde a \"%@\""
          }
        }
      }
    },
