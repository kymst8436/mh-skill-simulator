            "state": "translated",
            "value": "Mira un anuncio con recompensa para ocultar todos los anuncios durante 8 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez une publicité avec récompense pour masquer toutes les publicités pendant 8 heures."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보상형 광고를 시청하면 8시간 동안 모든 광고가 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
